rules_version = '2';
// REGALA Y GANA — la página NUNCA lee ni escribe Firestore directamente.
// Todo pasa por las funciones de /api (servidor, con la cuenta de servicio),
// que validan los datos, impiden duplicados y controlan el giro único.
// Por eso aquí se bloquea todo acceso desde navegadores.
// IMPORTANTE: usa un proyecto de Firebase SOLO para Regala y Gana.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
